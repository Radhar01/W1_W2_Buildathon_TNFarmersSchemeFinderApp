# ============================================================
# Copy this file to ".env" and fill in your values.
# ============================================================

# --- LLM (chatbot) settings ---
# Default points to Groq (fast, free tier). Get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Alternatives (uncomment ONE set instead of Groq) ---

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_key
# LLM_MODEL=gpt-4o-mini

# Local Ollama (no key needed, put any placeholder in LLM_API_KEY):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:0.5b

# --- Frontend -> backend address (used by Streamlit) ---
BACKEND_URL=http://localhost:8000
